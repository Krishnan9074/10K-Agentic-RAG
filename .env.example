# Required for chat / summaries / grounding checks — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional model overrides (any OpenRouter slug)
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# OPENROUTER_FAST_MODEL=google/gemini-3.8-flash

# SEC asks for a descriptive User-Agent with a contact email
SEC_USER_AGENT="10K-Agentic-RAG your-name your-email@example.com"

# Optional: Qdrant Cloud. Leave empty to use the embedded on-disk Qdrant in ./data/qdrant
# QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
# QDRANT_API_KEY=

# Optional: companies ingested automatically on first launch, refresh cadence
# SECRAG_WATCHLIST=AAPL,MSFT,GOOGL,AMZN
# SECRAG_AUTO_REFRESH_HOURS=12
